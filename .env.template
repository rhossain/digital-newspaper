# Environment variables for deployment
# Copy this file to .env and fill in your values

# FTP/SFTP Configuration
HOSTINGER_HOST=your_ftp_host
HOSTINGER_PORT=21
HOSTINGER_USER=your_username
HOSTINGER_PASS=your_password
HOSTINGER_REMOTE_PATH=/public_html/subdomain
HOSTINGER_USE_SFTP=false

# Deployment Strategy
# Options: 'incremental' (faster, only changed files) or 'full' (clean deploy)
DEPLOY_STRATEGY=incremental

# Dry Run (set to true to test without uploading)
DEPLOY_DRY_RUN=false

# GitHub Webhook Secret Configuration
# IMPORTANT: This is NOT the Hostinger webhook URL!
# 
# Two different webhook systems:
# 1. Hostinger Auto-Deploy (https://webhooks.hostinger.com/deploy/...) 
#    - This is Hostinger's built-in auto-deploy feature (NOT USED IN THIS PROJECT)
# 
# 2. GitHub Webhook + Our Custom webhook-server.js (USED IN THIS PROJECT)
#    - Requires a secret hash for HMAC-SHA256 signature verification
#    - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    - This hash must match what you enter in GitHub webhook settings
#
# Example correct value (hex hash):
# GITHUB_WEBHOOK_SECRET=c307cd680eca6807532c5984b4b76d7462ea3900101ca189c53f7c3a5adf513e
#
# WRONG: GITHUB_WEBHOOK_SECRET=https://webhooks.hostinger.com/...
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_hash_here

# Webhook Server Port
WEBHOOK_PORT=3001
