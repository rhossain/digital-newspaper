{
  "name": "digital-newspaper",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "build": "ng build && node scripts/promote-ngsw-boot-chunks.js && node scripts/compress-dist.js",
    "build:nocompress": "ng build && node scripts/promote-ngsw-boot-chunks.js",
    "compress": "node scripts/compress-dist.js",
    "build:staging": "ng build --configuration staging && node scripts/promote-ngsw-boot-chunks.js && node scripts/compress-dist.js",
    "serve:staging": "ng serve --configuration staging",
    "watch": "ng build --watch --configuration development",
    "deploy": "node deploy.js",
    "webhook": "node webhook-server.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/service-worker": "^21.2.16",
    "@fontsource-variable/google-sans": "^5.2.1",
    "express": "^4.22.2",
    "idb": "^8.0.3",
    "ngx-quill": "^30.1.3",
    "parchment": "^3.0.0",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "concurrently": "^8.2.2",
    "dotenv": "^17.2.4",
    "ftp-deploy": "^2.4.7",
    "ssh2-sftp-client": "^12.0.1",
    "typescript": "~5.9.0"
  }
}
