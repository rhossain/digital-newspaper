# Redirect all Angular routes to index.csr.html (the Angular SSR browser shell)


<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ---------------------------------------------------------------
  # Social media crawler detection
  # Internal rewrite (no redirect) to the WordPress /social endpoint so
  # crawlers receive proper OG / Twitter Card meta tags without running JS.
  #
  # WHY internal rewrite instead of 302 redirect:
  #   LiteSpeed/Apache decodes the request URI before mod_rewrite processes
  #   it, so backreferences ($1, $2) contain decoded text (raw Bengali Unicode).
  #   A 302 redirect would put that raw Unicode into the Location: header,
  #   violating RFC 7230. WhatsApp's crawler cannot follow such redirects and
  #   falls back to the generic site image.  An internal rewrite passes the
  #   request directly to WordPress with no Location header — no encoding issue.
  #
  # rest_route is used instead of the pretty-permalink /wp-json/ URL because
  # the internal rewrite does not update REQUEST_URI, so WordPress cannot
  # determine the REST route from the URL; the explicit rest_route param works
  # regardless of permalink configuration.
  # ---------------------------------------------------------------
  RewriteCond %{HTTP_USER_AGENT} "facebookexternalhit|Facebot|Twitterbot|Xbot|LinkedInBot|WhatsApp|Slackbot|Slackbot-LinkExpanding|TelegramBot|Discordbot|Pinterest|vkShare|W3C_Validator|Googlebot-Image" [NC]
  RewriteRule ^$ /wp/index.php?rest_route=/digital-newspaper/v1/social&homepage=1 [NE,L,QSA]

  # New canonical article URL format:
  #   /YYYY-MM-DD/page-XX/edition-XX/post-xxxx
  RewriteCond %{HTTP_USER_AGENT} "facebookexternalhit|Facebot|Twitterbot|Xbot|LinkedInBot|WhatsApp|Slackbot|Slackbot-LinkExpanding|TelegramBot|Discordbot|Pinterest|vkShare|W3C_Validator|Googlebot-Image" [NC]
  RewriteRule ^([0-9]{4}-[0-9]{2}-[0-9]{2})/(page-[^/]+)/((?:edition)-[^/]+)/([^/?]+)/?$ /wp/index.php?rest_route=/digital-newspaper/v1/social&date=$1&page=$2&edition=$3&slug=$4 [NE,L,QSA]

  # Legacy format kept for backward compatibility:
  #   /YYYY-MM-DD/section-slug
  RewriteCond %{HTTP_USER_AGENT} "facebookexternalhit|Facebot|Twitterbot|Xbot|LinkedInBot|WhatsApp|Slackbot|Slackbot-LinkExpanding|TelegramBot|Discordbot|Pinterest|vkShare|W3C_Validator|Googlebot-Image" [NC]
  RewriteRule ^([0-9]{4}-[0-9]{2}-[0-9]{2})/([^/?]+)/?$ /wp/index.php?rest_route=/digital-newspaper/v1/social&date=$1&slug=$2 [NE,L,QSA]

  # ── Root URL explicit rewrite ────────────────────────────────────────────────
  # / is a real directory on disk. The !-d catch-all at the bottom never fires
  # for it. DirectoryIndex in .htaccess only works if AllowOverride includes
  # "Indexes" — most shared hosts omit this, making DirectoryIndex silently
  # ignored. This rule handles the root request via mod_rewrite directly.
  # Crawler bots (handled above) have already exited with [L] before reaching here.
  #
  # Prefer the prerendered homepage (index.html) when it exists — users see
  # full newspaper content immediately with no blank page or loading spinner.
  # Fall back to index.csr.html (the CSR app shell) when prerendering failed
  # or was skipped during build (e.g. WordPress API unreachable at build time).
  RewriteCond %{DOCUMENT_ROOT}/index.html -f
  RewriteRule ^$ /index.html [L]
  RewriteRule ^$ /index.csr.html [L]

  # Serve existing files and directories directly
  # Prerendered homepage shell
  RewriteRule ^index\.html$ - [L]
  # Angular SSR builds rename the browser shell to index.csr.html
  RewriteRule ^index\.csr\.html$ - [L]
  # Compatibility redirects: if anyone hits root-level WP paths, forward to /wp.
  RewriteRule ^wp-admin/?$ /wp/wp-admin/ [R=302,L,NC]
  RewriteRule ^wp-login\.php$ /wp/wp-login.php [R=302,L,NC]
  RewriteRule ^xmlrpc\.php$ /wp/xmlrpc.php [R=302,L,NC]
  # Never route WordPress/admin/auth URLs through the Angular SPA.
  RewriteRule ^wp(?:/|$) - [L,NC]
  RewriteRule ^wp-admin(?:/|$) - [L,NC]
  RewriteRule ^wp-login\.php$ - [L,NC]
  RewriteRule ^xmlrpc\.php$ - [L,NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI}      !^/(wp|wp-admin)(?:/|$) [NC]
  RewriteCond %{REQUEST_URI}      !^/wp-login\.php$ [NC]
  RewriteCond %{REQUEST_URI}      !^/xmlrpc\.php$ [NC]
  # Catch-all: send everything else (including /admin/, /2026-01-01/, etc.) to index.csr.html
  # (Angular SSR builds rename the app shell from index.html → index.csr.html)
  RewriteRule ^ /index.csr.html [L]
</IfModule>

# Long-term caching for hashed Angular assets (JS, CSS, images)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
</IfModule>

# Gzip compression — reduces JS/CSS/JSON/HTML transfer sizes by ~60–70%.
# Guarded by IfModule so the file is safe on hosts without mod_deflate.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE font/woff
</IfModule>

# Service worker manifest must never be cached — browsers must always fetch the
# latest ngsw.json to detect updates and switch to the new service worker.
# Without this, a CDN or browser cache could serve a stale ngsw.json indefinitely,
# preventing the SW update cycle and leaving users on old CSS/font URLs.
<IfModule mod_headers.c>
  <FilesMatch "^(ngsw\.json|ngsw-worker\.js|safety-worker\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
